# Production Environment Configuration
ENVIRONMENT=production
DEBUG=false

# Database Configuration - Production
DATABASE_URL=postgresql+asyncpg://ai_user:${DB_PASSWORD}@prod-postgres-cluster:5432/ai_backend
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=true
DATABASE_MAX_OVERFLOW=30
DATABASE_ECHO=false
DATABASE_RETRY_ATTEMPTS=5
DATABASE_RETRY_DELAY=2.0

# Redis Configuration - Production
REDIS_URL=redis://prod-redis-cluster:6379/0
REDIS_POOL_SIZE=30
REDIS_RETRY_ATTEMPTS=5
CACHE_TTL=7200

# OpenAI Configuration - Production
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_ORG_ID=${OPENAI_ORG_ID}
OPENAI_TIMEOUT=180
OPENAI_MAX_RETRIES=5
DEFAULT_MODEL=gpt-4

# Security Configuration - Production
JWT_SECRET=${JWT_SECRET}
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY_HASH_SALT=${API_KEY_HASH_SALT}

# Security Headers - Production
FORCE_HTTPS=true
SECURE_COOKIES=true

# Rate Limiting - Production
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60
RATE_LIMIT_ENABLED=true

# Logging Configuration - Production
LOG_LEVEL=WARNING
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/ai-backend/app.log
LOG_ROTATION_SIZE=500 MB
LOG_RETENTION_DAYS=90

# Monitoring - Production
HEALTH_CHECK_TIMEOUT=15
METRICS_ENABLED=true

# CORS Configuration - Production
ALLOWED_ORIGINS=https://yourapp.com,https://admin.yourapp.com,https://api.yourapp.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Authorization,Content-Type,X-API-Key

# Production Settings
WORKER_PROCESSES=4
WORKER_CONNECTIONS=2000
KEEPALIVE_TIMEOUT=65

# Backup and Maintenance - Production
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
MAINTENANCE_MODE=false

# Production-specific monitoring
SENTRY_DSN=${SENTRY_DSN}
DATADOG_API_KEY=${DATADOG_API_KEY}
NEW_RELIC_LICENSE_KEY=${NEW_RELIC_LICENSE_KEY}