# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_backend
DATABASE_POOL_SIZE=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_here
DEFAULT_MODEL=gpt-4

# Security
JWT_SECRET=your_jwt_secret_here
API_KEY_HASH_SALT=your_salt_here

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# SaaS Project Finder Configuration
# MCP (Model Context Protocol) Configuration
MCP_SERVER_URL=http://localhost:8080
MCP_API_KEY=your_mcp_api_key_here

# Email Service Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM_ADDRESS=saas-finder@yourcompany.com
EMAIL_REPORT_RECIPIENTS=admin@yourcompany.com,team@yourcompany.com

# External API Keys for SaaS Idea Discovery
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
PRODUCTHUNT_API_TOKEN=your_producthunt_token
INDIEHACKERS_API_KEY=your_indiehackers_key

# Google Services
GOOGLE_TRENDS_API_KEY=your_google_trends_key
SERPAPI_KEY=your_serpapi_key

# Domain Checking Service
DOMAIN_API_KEY=your_domain_api_key

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# Analysis Configuration
ANALYSIS_BATCH_SIZE=10
MAX_ANALYSIS_RETRIES=3
ANALYSIS_TIMEOUT_SECONDS=300

# Scoring Weights (0.0 to 1.0, should sum to 1.0)
TREND_WEIGHT=0.25
MARKET_WEIGHT=0.20
AI_SUITABILITY_WEIGHT=0.20
COMPETITION_WEIGHT=0.15
FEASIBILITY_WEIGHT=0.10
MONETIZATION_WEIGHT=0.10

# Alert Thresholds
HIGH_POTENTIAL_SCORE_THRESHOLD=85.0
TRENDING_ALERT_THRESHOLD=80.0
IMMEDIATE_ALERT_ENABLED=true

# Data Retention
IDEA_RETENTION_DAYS=365
METRICS_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30