# Environment Configuration
ENVIRONMENT=development
DEBUG=false

# Database Configuration
DATABASE_URL=postgresql+asyncpg://ai_user:your_password@postgres:5432/ai_backend
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=true
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false
DATABASE_RETRY_ATTEMPTS=3
DATABASE_RETRY_DELAY=1.0

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=20
REDIS_RETRY_ATTEMPTS=3
CACHE_TTL=3600

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-openai-org-id
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=3
DEFAULT_MODEL=gpt-4

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY_HASH_SALT=your-api-key-hash-salt-min-32-chars

# Security Headers
FORCE_HTTPS=false
SECURE_COOKIES=false

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_ENABLED=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log
LOG_ROTATION_SIZE=100 MB
LOG_RETENTION_DAYS=30

# Monitoring
HEALTH_CHECK_TIMEOUT=10
METRICS_ENABLED=true

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# Production Settings
WORKER_PROCESSES=1
WORKER_CONNECTIONS=1000
KEEPALIVE_TIMEOUT=65

# Backup and Maintenance
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
MAINTENANCE_MODE=false

# SaaS Project Finder Configuration
# MCP (Model Context Protocol) Configuration
MCP_SERVER_URL=http://localhost:8080
MCP_API_KEY=your_mcp_api_key_here

# Email Service Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM_ADDRESS=saas-finder@yourcompany.com
EMAIL_REPORT_RECIPIENTS=admin@yourcompany.com,team@yourcompany.com

# External API Keys for SaaS Idea Discovery
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
PRODUCTHUNT_API_TOKEN=your_producthunt_token

# Google Services
GOOGLE_TRENDS_API_KEY=your_google_trends_key
SERPAPI_KEY=your_serpapi_key

# Domain Checking Service
DOMAIN_API_KEY=your_domain_api_key

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# Analysis Configuration
ANALYSIS_BATCH_SIZE=10
MAX_ANALYSIS_RETRIES=3
ANALYSIS_TIMEOUT_SECONDS=300

# Scoring Weights (0.0 to 1.0, should sum to 1.0)
TREND_WEIGHT=0.25
MARKET_WEIGHT=0.20
AI_SUITABILITY_WEIGHT=0.20
COMPETITION_WEIGHT=0.15
FEASIBILITY_WEIGHT=0.10
MONETIZATION_WEIGHT=0.10

# Alert Thresholds
HIGH_POTENTIAL_SCORE_THRESHOLD=85.0
TRENDING_ALERT_THRESHOLD=80.0
IMMEDIATE_ALERT_ENABLED=true

# Data Retention
IDEA_RETENTION_DAYS=365
METRICS_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30