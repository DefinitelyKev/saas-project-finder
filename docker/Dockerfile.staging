# Multi-stage build for staging
FROM python:3.11-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Staging stage
FROM python:3.11-slim as staging

# Set build arguments
ARG ENVIRONMENT=staging
ENV ENVIRONMENT=${ENVIRONMENT}

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy Python packages from builder stage
COPY --from=builder /root/.local /root/.local

# Make sure scripts in .local are usable
ENV PATH=/root/.local/bin:$PATH

# Copy application code
COPY src/ ./src/
COPY pyproject.toml .
COPY alembic.ini .
COPY alembic/ ./alembic/

# Create non-root user with proper permissions
RUN groupadd -r app && useradd -r -g app app \
    && mkdir -p /var/log/ai-backend \
    && chown -R app:app /app /var/log/ai-backend

USER app

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run database migrations and start the application with Gunicorn
CMD ["sh", "-c", "alembic upgrade head && gunicorn src.main:app -w 2 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --timeout 120 --keepalive 5 --max-requests 500 --access-logfile /var/log/ai-backend/access.log --error-logfile /var/log/ai-backend/error.log --log-level info"]