# Staging Environment Configuration
ENVIRONMENT=staging
DEBUG=false

# Database Configuration - Staging
DATABASE_URL=postgresql+asyncpg://ai_user:${DB_PASSWORD}@staging-postgres:5432/ai_backend
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=20
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true
DATABASE_MAX_OVERFLOW=15
DATABASE_ECHO=false
DATABASE_RETRY_ATTEMPTS=3
DATABASE_RETRY_DELAY=1.0

# Redis Configuration - Staging
REDIS_URL=redis://staging-redis:6379/0
REDIS_POOL_SIZE=15
REDIS_RETRY_ATTEMPTS=3
CACHE_TTL=3600

# OpenAI Configuration
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_ORG_ID=${OPENAI_ORG_ID}
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=3
DEFAULT_MODEL=gpt-4

# Security Configuration - Staging
JWT_SECRET=${JWT_SECRET}
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY_HASH_SALT=${API_KEY_HASH_SALT}

# Security Headers - Staging
FORCE_HTTPS=true
SECURE_COOKIES=true

# Rate Limiting - Staging
RATE_LIMIT_REQUESTS=500
RATE_LIMIT_WINDOW=60
RATE_LIMIT_ENABLED=true

# Logging Configuration - Staging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/ai-backend/app.log
LOG_ROTATION_SIZE=100 MB
LOG_RETENTION_DAYS=30

# Monitoring - Staging
HEALTH_CHECK_TIMEOUT=10
METRICS_ENABLED=true

# CORS Configuration - Staging
ALLOWED_ORIGINS=https://staging.yourapp.com,https://admin-staging.yourapp.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# Production Settings - Staging
WORKER_PROCESSES=2
WORKER_CONNECTIONS=1000
KEEPALIVE_TIMEOUT=65

# Backup and Maintenance - Staging
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
MAINTENANCE_MODE=false